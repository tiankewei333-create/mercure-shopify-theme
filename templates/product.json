{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "highlights": {
          "type": "hb_highlights"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "spec_sheet": {
          "type": "hb_spec_sheet",
          "settings": {
            "sheet": "{{ product.metafields.custom.spec_sheet.value }}",
            "button_label": "Sizes & specifications"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "highlights",
        "variant_picker",
        "spec_sheet",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "configurator": {
      "type": "hb-3d-configurator",
      "blocks": {
        "finish_black": {
          "type": "finish",
          "settings": {
            "option_value": "Matte black",
            "body_color": "#1d1d1f",
            "surface": "matte",
            "handle_color": "#141414",
            "knob_color": "#6b4a2f"
          }
        },
        "finish_steel": {
          "type": "finish",
          "settings": {
            "option_value": "Brushed steel",
            "body_color": "#c9ccd1",
            "surface": "satin",
            "handle_color": "#141414",
            "knob_color": "#6b4a2f"
          }
        },
        "finish_white": {
          "type": "finish",
          "settings": {
            "option_value": "Stone white",
            "body_color": "#ece8e1",
            "surface": "matte",
            "handle_color": "#8a6343",
            "knob_color": "#8a6343"
          }
        },
        "hotspot_spout": {
          "type": "hotspot",
          "settings": {
            "part": "spout",
            "title": "Tapered spout",
            "text": "The gooseneck narrows to a 7 mm tip, so the stream stays thin and steady at 4–6 g per second, even when the kettle is full."
          }
        },
        "hotspot_handle": {
          "type": "hotspot",
          "settings": {
            "part": "handle",
            "title": "Counterweighted handle",
            "text": "Set back from the body so the kettle balances in your hand when full. It stays cool on the hob."
          }
        },
        "hotspot_lid": {
          "type": "hotspot",
          "settings": {
            "part": "lid",
            "title": "Walnut knob lid",
            "text": "Sits on a silicone ring, so it stays put when you tip the kettle all the way. The walnut knob never gets hot."
          }
        },
        "hotspot_base": {
          "type": "hotspot",
          "settings": {
            "part": "base",
            "title": "Induction-ready base",
            "text": "Magnetic stainless steel base that works on gas, electric and induction hobs."
          }
        }
      },
      "block_order": [
        "finish_black",
        "finish_steel",
        "finish_white",
        "hotspot_spout",
        "hotspot_handle",
        "hotspot_lid",
        "hotspot_base"
      ],
      "settings": {
        "model": "{{ product.metafields.custom.three_d_model.value }}",
        "eyebrow": "Make it yours",
        "heading": "See every detail in 3D",
        "text": "<p>Drag to turn it around, tap a point to look closer, and pick the finish for your counter.</p>",
        "finish_option": "Finish",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "bundle": {
      "type": "hb-bundle",
      "settings": {
        "heading": "Complete the set",
        "text": "<p>Everything this needs, added in one go.</p>",
        "products": "{{ product.metafields.custom.bundle_products.value }}",
        "include_current": true,
        "preselect": true,
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "brew_guide": {
      "type": "hb-brew-guide",
      "settings": {
        "guide": "{{ product.metafields.custom.brew_guide.value }}",
        "eyebrow": "Brew guide",
        "heading": "How we brew it",
        "show_image": true,
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 36
      }
    },
    "faq": {
      "type": "hb-faq",
      "settings": {
        "heading": "About this product",
        "text": "",
        "faqs": "{{ product.metafields.custom.faqs.value }}",
        "structured_data": true,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "configurator",
    "bundle",
    "brew_guide",
    "faq",
    "disclosures",
    "related-products"
  ]
}
