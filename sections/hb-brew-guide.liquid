{%- comment -%}
  Recipe card from a brew_guide metaobject: key numbers (dose, water, ratio, temperature, grind, time) and steps.
  On product pages the `guide` setting is connected to product.metafields.custom.brew_guide; elsewhere the
  merchant picks an entry. Every field is optional; the section renders nothing without a guide.
{%- endcomment -%}
{%- liquid
  assign guide = section.settings.guide
  assign dose = guide.dose_g.value
  assign water = guide.water_g.value
  assign ratio = blank
  if dose > 0 and water > 0
    assign ratio = water | times: 1.0 | divided_by: dose | round: 1 | append: '' | remove: '.0'
  endif
-%}

{%- if guide != blank -%}
  {{ 'section-hb-brew-guide.css' | asset_url | stylesheet_tag }}
  {%- render 'hb-section-padding', section: section -%}

  {%- liquid
    assign title_id = 'BrewGuide-' | append: section.id
    assign show_image = false
    if section.settings.show_image and guide.image.value != blank
      assign show_image = true
    endif
  -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <article
      class="hb-brew page-width section-{{ section.id }}-padding{% if show_image %} hb-brew--with-image{% endif %}"
      aria-labelledby="{{ title_id }}"
    >
      {%- if show_image -%}
        <div class="hb-brew__media">
          {{-
            guide.image.value
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 900, 1200',
              sizes: '(min-width: 990px) 40vw, calc(100vw - 3rem)',
              alt: guide.title.value
          -}}
        </div>
      {%- endif -%}

      <div class="hb-brew__body">
        <header class="hb-section-header">
          {%- assign eyebrow = guide.method.value | default: section.settings.eyebrow -%}
          {%- if eyebrow != blank -%}
            <p class="hb-eyebrow">{{ eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="{{ title_id }}" class="h2">{{ guide.title.value | default: section.settings.heading | escape }}</h2>
        </header>

        {%- capture stats -%}
          {%- if dose > 0 -%}
            <div class="hb-brew__stat">
              <dt>{{ 'hb.brew_guide.dose' | t }}</dt>
              <dd>{{ 'hb.brew_guide.grams' | t: value: dose }}</dd>
            </div>
          {%- endif -%}
          {%- if water > 0 -%}
            <div class="hb-brew__stat">
              <dt>{{ 'hb.brew_guide.water' | t }}</dt>
              <dd>{{ 'hb.brew_guide.grams' | t: value: water }}</dd>
            </div>
          {%- endif -%}
          {%- if ratio != blank -%}
            <div class="hb-brew__stat">
              <dt>{{ 'hb.brew_guide.ratio' | t }}</dt>
              <dd>1:{{ ratio }}</dd>
            </div>
          {%- endif -%}
          {%- if guide.temperature_c.value > 0 -%}
            <div class="hb-brew__stat">
              <dt>{{ 'hb.brew_guide.temperature' | t }}</dt>
              <dd>{{ 'hb.brew_guide.celsius' | t: value: guide.temperature_c.value }}</dd>
            </div>
          {%- endif -%}
          {%- if guide.grind.value != blank -%}
            <div class="hb-brew__stat">
              <dt>{{ 'hb.brew_guide.grind' | t }}</dt>
              <dd>{{ guide.grind.value | escape }}</dd>
            </div>
          {%- endif -%}
          {%- if guide.total_time.value != blank -%}
            <div class="hb-brew__stat">
              <dt>{{ 'hb.brew_guide.time' | t }}</dt>
              <dd>{{ guide.total_time.value | escape }}</dd>
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- if stats != blank -%}
          <dl class="hb-brew__stats">{{ stats }}</dl>
        {%- endif -%}

        {%- capture steps -%}
          {%- for step in guide.steps.value -%}
            {%- assign step_text = step | strip -%}
            {%- if step_text != blank -%}
              <li>{{ step_text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if steps != blank -%}
          <h3 class="hb-brew__steps-title h4">{{ 'hb.brew_guide.steps' | t }}</h3>
          <ol class="hb-brew__steps" role="list">{{ steps }}</ol>
        {%- endif -%}
      </div>
    </article>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width">
    <p class="hb-editor-hint">
      Brew guide is hidden: pick a guide, or on product templates connect the setting to the product's
      <strong>Brew guide</strong> metafield.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Brew guide",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "metaobject",
      "id": "guide",
      "metaobject_type": "brew_guide",
      "label": "Brew guide",
      "info": "On product templates, connect this to the product's \"Brew guide\" metafield so each product shows its own recipe."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow fallback",
      "info": "Used when the guide has no method.",
      "default": "Brew guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "info": "Used when the guide has no title.",
      "default": "How we brew it"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show the guide's image",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Brew guide"
    }
  ]
}
{% endschema %}
